{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/edge-function"
    },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    {
      "src": "^/api/.*",
      "dest": "api/index.ts"
    },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
