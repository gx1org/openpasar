{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "backend/adapters/vercel.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "backend/adapters/vercel.ts" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ],
  "outputDirectory": "frontend/dist"
}